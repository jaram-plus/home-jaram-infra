# Common
TZ=Asia/Seoul

# Host bind for exposed ports.
# Default 127.0.0.1 = VM 내부에서만 접근 가능 (cloudflared 붙이기 전 수동 검증용).
# Headscale/Tailscale 내부망에서 다른 기기 접속 테스트 = 0.0.0.0 또는 해당 IP.
HOST_BIND=127.0.0.1

# Image tags (mutable). 기본 develop.
# 롤백/고정 배포 시 sha-ca11d58 형태로 변경.
FRONTEND_DEV_TAG=develop
BACKEND_DEV_TAG=develop

# Dev exposed ports (host side). cloudflared 도입 후엔 의미 없어짐.
FRONTEND_DEV_PORT=3001
BACKEND_DEV_PORT=8081

# Frontend runtime config
# 브라우저가 호출할 BE URL. 컨테이너 내부 주소(backend-dev:8080) 아님.
# FE 이미지의 nginx entrypoint가 /config.js로 bake함.
# cloudflared 도입 전 수동 검증: http://localhost:8081
# cloudflared 이후 dev 환경:    https://dev-api.jaram.net
FRONTEND_DEV_API_BASE_URL=http://localhost:8081

# PostgreSQL dev
DB_NAME=jaram_dev
DB_USER=jaram_dev
DB_PASSWORD=change-me-dev-db-password

# Spring Boot datasource. compose 내부 통신이므로 service name `db` 사용.
DB_URL=jdbc:postgresql://db:5432/jaram_dev

# Backend dev config
# 최소 32 bytes 이상 강한 값으로 변경.
JWT_SECRET=change-me-dev-jwt-secret-min-32-bytes-long!!

# CORS allowed origins (콤마 구분 리스트).
# cloudflared 도입 전: http://localhost:3001
# cloudflared 이후 dev 환경:
# CORS_ALLOWED_ORIGINS=http://localhost:3001,https://dev.jaram.net
CORS_ALLOWED_ORIGINS=http://localhost:3001
